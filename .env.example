# FleetOps — DEVELOPMENT-ONLY example configuration. Copy to `.env`.
# Every value below is a throw-away local credential. Do NOT reuse in any shared
# or production environment; generate fresh secrets (`openssl rand -hex 32`).

FLEETOPS_ENV=dev

# Management API keys (Bearer). Roles: viewer < operator < admin.
FLEETOPS_ADMIN_API_KEY=dev-admin-key-change-me-0001
FLEETOPS_OPERATOR_API_KEY=dev-operator-key-change-me-02
FLEETOPS_VIEWER_API_KEY=dev-viewer-key-change-me-0003

# Master secret from which per-device credentials are derived (HMAC-KDF).
FLEETOPS_DEVICE_KEY_MASTER=dev-device-master-key-change-me-0004

# MQTT
FLEETOPS_MQTT_USERNAME=control-plane
FLEETOPS_MQTT_PASSWORD=dev-mqtt-password-change-me-05

# Enable deterministic failure-injection endpoints (never in production).
FLEETOPS_SIMULATION_ENABLED=true

# Grafana admin password (compose only)
GRAFANA_ADMIN_PASSWORD=dev-grafana-change-me-0006

# MLflow runs with basic-auth. `admin` is for humans (UI); the control plane uses the non-admin
# service account FLEETOPS_MLFLOW_USERNAME with FLEETOPS_MLFLOW_PASSWORD (created by the mlflow-init service).
FLEETOPS_MLFLOW_ADMIN_PASSWORD=dev-mlflow-admin-change-me-07
FLEETOPS_MLFLOW_USERNAME=fleetops-cp
FLEETOPS_MLFLOW_PASSWORD=dev-mlflow-service-change-me-08
FLEETOPS_MLFLOW_FLASK_SECRET=dev-mlflow-flask-secret-change-me-09

# Interface the Compose stack publishes on. Default: loopback only. Set 0.0.0.0 only on a trusted network.
FLEETOPS_BIND=127.0.0.1

# Scrape credential: can read /metrics and nothing else (Prometheus uses it for the control plane and every agent).
FLEETOPS_METRICS_TOKEN=dev-metrics-scrape-token-change-me-10
# Token that clients of the agent API (/predict, /healthz; e.g. a PLC gateway) must present.
FLEETOPS_EDGE_API_TOKEN=dev-edge-api-token-change-me-0011
